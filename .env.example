# 이 파일을 .env 로 복사해 값을 채운다. .env 는 공유·커밋하지 않는다.
UPSTAGE_API_KEY=
# Studio 워크플로우 Code 패널의 Agent ID (agt_...)
AGENT_GRADE=agt_FDBBzsEzYMYFoountEQM9M
AGENT_MASK_MID=agt_Kjrj85Z4eMwXQMd7AsSfXT
AGENT_MASK_LOW=agt_Vz5tWfeyE9ctihjXJhztha
# 필수. 모든 문서가 가장 먼저 거치는 분할(Classify Split) 워크플로우. 한 문서인지 여러 문서인지 여기서 정해진다.
AGENT_SPLIT=
AGENT_SPLIT_CONFIG=
# 각 워크플로우 버전(Config ID). 비우면 default = 최신 버전. 고정하려면 id를 넣는다.
AGENT_GRADE_CONFIG=
AGENT_MASK_MID_CONFIG=
AGENT_MASK_LOW_CONFIG=
